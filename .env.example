# agent-memory-server — environment variables.
# Copy this file to `.env` and fill in the values you need. `.env` is gitignored.

# ── Core (required) ────────────────────────────────────────────────
# Shared secret clients must send as `X-API-Key: <API_KEY>` when calling
# the REST API. Any random string is fine; rotate if exposed.
API_KEY=

# JWT signing secret for the MCP OAuth flow. Generate 32+ random bytes:
#   python -c "import secrets; print(secrets.token_hex(32))"
MCP_JWT_SECRET=

# Single-user password for the MCP `/authorize` endpoint.
MCP_ADMIN_PASS=

# ── Core (optional, sensible defaults) ─────────────────────────────
# Owner handle stored in `instructions.given_by` and used as the SQL default.
OWNER_HANDLE=owner

# URLs the app advertises in status pages / OAuth redirects.
# AMS_LAN_URL=
AMS_PUBLIC_URL=http://localhost:8000

# MCP server (mcp_server.py). ISSUER_URL is what the OAuth flow advertises;
# set this to your publicly reachable https URL if you tunnel the port.
MCP_ISSUER_URL=http://localhost:8001
MCP_PORT=8001

# Override the SQLite database location. Defaults to ./memory.db.
# AMS_DB_PATH=./memory.db

# Directory containing agent prompt files. Defaults to ./prompts/.
# AGENT_PROMPT_DIR=./prompts/

# Comma-separated allowlist of agent names. Leave empty (or unset) to accept
# any non-empty agent name — recommended for fresh installs. Set explicitly
# (e.g. "alice,bob,carol") to reject writes whose agent field is outside
# the list.
VALID_AGENTS=

# JSON mapping of agent name -> Claude Project UUID, consumed by
# sync_status_to_project.py to broadcast agent_status.md to Claude Projects.
# Leave as "{}" to disable broadcast.
AGENT_PROJECTS={}

# ── Agent registry (all JSON; leave defaults for a fresh install) ──
# Basename of the default operator prompt. Loaded from
# <AGENT_PROMPT_DIR>/<DEFAULT_AGENT>.md (falling back to .example.md).
DEFAULT_AGENT=default

# Display-name → prompt basename. Extra personas beyond DEFAULT_AGENT are
# looked up here. e.g. {"Alice":"alice"} → prompts/alice.md or .example.md
AGENT_PROMPT_MAP={}

# Roman-key → display-name map (used for per-agent context file naming).
# e.g. {"alice":"Alice","bob":"Bob"}
AGENT_NAME_JA={}

# Structured agent registry for the status dashboard. List of dicts:
#   [{"name":"Alice","role":"...","drive_id":"1abc..."}]
# Leave as [] to skip the per-agent dashboard rows entirely.
AGENT_DEFINITIONS=[]

# Display-name → Google Drive folder id, consumed by drive_sync.py and
# migrate_drive_sessions.py. Leave {} to disable drive sync entirely.
AGENT_DRIVE_FOLDERS={}

# Example strings shown when the app-status parser cannot extract anything.
# Multi-line: separate examples with a literal '|'.
STATUS_UPDATE_HINT_EXAMPLES=

# ── Optional study-coach flow (all inert unless configured) ────────
# Trigger keyword that routes a message through STUDY_COACH_SYSTEM_PROMPT.
# Empty = feature disabled.
STUDY_COACH_TRIGGER=
# Additional keywords (JSON array) that further scope the trigger. If both
# STUDY_COACH_TRIGGER and one of these appear in the message, the study-coach
# handler runs. e.g. ["homework","exam"]
STUDY_COACH_KEYWORDS=[]
# System prompt for the study-coach persona (single-line, escape newlines).
STUDY_COACH_SYSTEM_PROMPT=
# Agent name recorded on rows the study-coach flow writes into memory.
# Leave empty to inherit DEFAULT_AGENT.
STUDY_COACH_AGENT=

# ── Optional lesson-tracker Notion integration (inert unless set) ──
# JSON array of keywords that trigger the lesson-tracker query. e.g.
# ["progress","remaining"]. Empty [] = feature disabled.
LESSON_TRACKER_KEYWORDS=[]
# Human-readable label prefix used in Notion output rows.
LESSON_TRACKER_LABEL=
# Regex pattern (Python re syntax) used to parse a week number out of the
# user's message, e.g. r"week\s*(\d+)". Empty = disabled.
LESSON_TRACKER_WEEK_PATTERN=

# ── Optional study-map endpoint (inert unless set) ────────────────
# Comma-separated list of subjects the /api/study-map endpoint accepts.
# Empty = endpoint rejects everything with 400.
STUDY_MAP_SUBJECTS=
# System prompt used by /api/study-map/generate. Empty = feature disabled.
STUDY_MAP_SYSTEM_PROMPT=

# ── LLM (required for the executor and morning report) ────────────
ANTHROPIC_API_KEY=

# ── LINE integration (optional — disabled if unset) ────────────────
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# The LINE user id that is allowed to talk to the bot. Other user ids
# are silently dropped from the webhook.
LINE_USER_ID=

# ── Slack integration (optional — disabled if unset) ───────────────
SLACK_BOT_TOKEN=
SLACK_USER_ID=
SLACK_SIGNING_SECRET=
# Optional: pin the DM channel id (Dxxxxxxxx). Auto-discovered if unset.
SLACK_DM_CHANNEL=
# Optional: initial backfill window in hours (default 24).
SLACK_INGEST_INITIAL_HOURS=

# ── Notion integration (optional — disabled if unset) ──────────────
NOTION_TOKEN=
# Notion database used by the lesson-tracker feature (see LESSON_TRACKER_*).
NOTION_LESSON_DATABASE_ID=
